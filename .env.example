# Meta — all calls go DIRECTLY to https://api.meta.ai/v1 (hackathon credits).
# Do not route through Vercel AI Gateway or OpenRouter (separate billing).
MODEL_API_KEY=
META_API_KEY=            # same value; some SDKs read this name
META_API_BASE=https://api.meta.ai/v1
MODEL_LIVE=muse-spark-1.3
MODEL_EXTRACT=muse-wonder-1.0
MODEL_JUDGE=muse-spark-1.3
MODEL_TRANSLATE=muse-spark-1.3
MODEL_SIMCALLER=muse-spark-1.3-contributor
MODEL_STT=muse-voice-transcribe-1.0
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
# TTS (ElevenLabs Flash — Hanna's voice; do not enable their STT/Agents)
ELEVENLABS_API_KEY=
# Optional shared fallback. Prefer language-specific IDs below.
ELEVENLABS_VOICE_ID=
# Hungarian library voice (default: Vivianna hu-standard)
ELEVENLABS_VOICE_ID_HU=9QppwToemG29A6UTSbwz
# English premade (default: Sarah)
ELEVENLABS_VOICE_ID_EN=EXAVITQu4vr4xnSDxMaL
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Telephony — Twilio US softphone (Meta EN demo) + Telnyx HU DID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=     # E.164 e.g. ***REMOVED***
TWILIO_API_KEY_SID=      # API Key for Access Tokens
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=    # TwiML App → /api/twilio/client-voice
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=     # E.164 e.g. ***REMOVED***
# Facebook Page import — Graph token (dev mode + your Page is enough).
# Without this, FB HTML is often login-walled and we cannot find the linked
# website (e.g. vakvarju.com) to crawl together with the Page.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: Apify Website Content Crawler (falls back to local crawl if unset)
APIFY_TOKEN=
# Provisioning (local-only, never committed; used once to create cloud resources)
NEON_API_KEY=
VERCEL_TOKEN=
# App
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGNING_SECRET=    # Svix signing secret from Clerk webhook endpoint
# Comma-separated Clerk emails that may open /dashboard and /onboarding (admin only).
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOOLS_HMAC_SECRET=
ENCRYPTION_KEY=
VOICE_SERVICE_URL=
APP_URL=https://dialhanna.com
NEXT_PUBLIC_APP_URL=https://dialhanna.com
RESEND_API_KEY=
